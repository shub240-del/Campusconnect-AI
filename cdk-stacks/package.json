{
  "name": "cdk-stacks",
  "version": "3.1.0",
  "description": "AWS End User Messaging GenAI Chatbot",
  "main": "configure.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "configure": "node configure.js -il",
    "configure:test": "node configure.js -ilt",
    "install:cdk-stacks": "npm install",
    "install:lambdas": "cd lib/lambdas/handlers/node && npm install",
    "install:all": "npm run install:cdk-stacks && npm run install:lambdas",
    "cdk:remove:context": "rm -f cdk.context.json",
    "cdk:deploy": "npm run build:agent && npm run cdk:remove:context && cdk deploy --all --disable-rollback -c application_version=$npm_package_version",
    "cdk:deploy:gitbash": "npm run build:agent && npm run cdk:remove:context && winpty cdk.cmd deploy --all --disable-rollback -c application_version=$npm_package_version",
    "build:agent": "pip3 install -r ../sample-agentcore-agent/requirements.txt -t ../sample-agentcore-agent/lib --platform manylinux2014_aarch64 --only-binary=:all: --python-version 3.12 --upgrade --quiet",
    "build:deploy:all": "npm run cdk:deploy",
    "build:deploy:all:gitbash": "npm run cdk:deploy:gitbash",
    "cdk:synth": "cdk synth -c application_version=$npm_package_version"
  },
  "author": "prod-apps-builder-team",
  "license": "MIT-0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/node": "^18.7.16",
    "babel-jest": "^30.4.1",
    "cdk-nag": "^2.27.108",
    "constructs": "^10.2.69",
    "esbuild": "^0.25.0",
    "fast-check": "^3.23.2",
    "jest": "^29.6.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@aws-cdk/aws-apigatewayv2-alpha": "^2.114.1-alpha.0",
    "@aws-cdk/aws-apigatewayv2-authorizers-alpha": "^2.114.1-alpha.0",
    "@aws-cdk/aws-apigatewayv2-integrations-alpha": "^2.114.1-alpha.0",
    "@aws-sdk/client-ssm": "^3.1027.0",
    "@cdklabs/generative-ai-cdk-constructs": "^0.1.292",
    "aws-cdk": "^2.178.2",
    "aws-cdk-lib": "^2.263.0",
    "source-map-support": "^0.5.21"
  }
}
